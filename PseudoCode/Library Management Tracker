
Library Membership Tracker

Start
CLASS Member
    ATTRIBUTES: name, memberId, membershipDate, validityMonths
    CONSTRUCTOR(name, memberId, membershipDate, validityMonths)
        SET this.name = name
        SET this.memberId = memberId
        SET this.membershipDate = membershipDate
        SET this.validityMonths = validityMonths

    METHOD checkMembershipValidity(currentDate)
        CALCULATE expiryDate = membershipDate + validityMonths
        IF currentDate <= expiryDate
            PRINT "Membership is valid"
        ELSE
            PRINT "Membership expired"

MAIN
    CREATE Member m WITH ("John Doe", "M123", "2025-01-01", 12)
    CALL m.checkMembershipValidity("2025-08-14")
End

