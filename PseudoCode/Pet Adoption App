Pet Adoption App

Start
CLASS Pet
    ATTRIBUTES: name, age
    CONSTRUCTOR(name, age)
        SET this.name = name
        SET this.age = age
    METHOD displayDetails()
        PRINT name, age

CLASS Dog EXTENDS Pet
    ATTRIBUTES: breed
    CONSTRUCTOR(name, age, breed)
        SET this.breed = breed
    METHOD displayDetails()
       
        PRINT breed

CLASS Cat EXTENDS Pet
    ATTRIBUTES: color
    CONSTRUCTOR(name, age, color)
        
        SET this.color = color
    METHOD displayDetails()
        
        PRINT color

CLASS Bird EXTENDS Pet
    ATTRIBUTES: canFly
    CONSTRUCTOR(name, age, canFly)
        SET this.canFly = canFly
    METHOD displayDetails()
        PRINT canFly

MAIN
    CREATE Dog d WITH ("Tommy", 3, "Labrador")
    CREATE Cat c WITH ("Kitty", 2, "White")
    CREATE Bird b WITH ("Tweety", 1, true)
    CALL d.displayDetails()
    CALL c.displayDetails()
    CALL b.displayDetails()
End

